{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MangaDB",
      "dependsOn": ["mangadb", "db", "db:studio"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "mangadb",
      "type": "shell",
      "command": "pnpm dev",
      "presentation": {
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "db",
      "type": "shell",
      "command": "docker compose up",
      "presentation": {
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "db:studio",
      "type": "shell",
      "command": "pnpm db:studio",
      "presentation": {
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
